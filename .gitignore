# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
.env/

# Logs and runtime state
logs/
*.log
flask_session/
runs/

# Local caches
config/geoip_cache.json

# Editor and OS files
.DS_Store
Thumbs.db
.vscode/
.idea/

# 本地 API credentials (runtime-generated, never commit)
attack_resources/shared/api_credentials.json

# 任务队列运行时状态（队列状态 + 并发上限配置）
attack_resources/shared/queue_state.json
attack_resources/shared/queue_config.json

# ZMap build artifacts and binaries (machine-specific, must rebuild on each device)
vendor/weaponizing-censors/*/build/
vendor/weaponizing-censors/*/CMakeCache.txt
vendor/weaponizing-censors/*/CMakeFiles/
vendor/weaponizing-censors/*/src/CMakeFiles/
vendor/weaponizing-censors/*/src/zmap
vendor/weaponizing-censors/*/src/ztee
vendor/weaponizing-censors/*/src/ziterate
vendor/weaponizing-censors/*/src/ztests
vendor/weaponizing-censors/*/lib/*.a

# ── 运行时数据（扫描产物 / 自动生成 IP 池） ──
# 各协议优质 IP 池（扫描后产生）
attack_resources/*/qualified_pool/*.txt
attack_resources/*/qualified_pool/*.json

# 各协议资源文件（运行时生成 / 自动抓取填充）
attack_resources/*/resources/ip_lists/*.txt

# 共享资源池自动抓取
attack_resources/shared/ip_lists/auto/

# 本地临时调试脚本
_check_*.sh
_check_*.py
